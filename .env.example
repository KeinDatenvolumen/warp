# [KI-Log Nr. KI-21] KI-generiert (Google Antigravity (Gemini 3.8 Flash High)): Asynchrone RabbitMQ Mail-Queue & Broker-Fallback (WARP-036)
IDENTITY_DB_NAME=warp_identity
IDENTITY_DB_USER=warp_identity
IDENTITY_DB_PASSWORD=local_identity_change_me

ROUTING_DB_NAME=warp_routing
ROUTING_DB_USER=warp_routing
ROUTING_DB_PASSWORD=local_routing_change_me

WEATHER_DB_NAME=warp_weather
WEATHER_DB_USER=warp_weather
WEATHER_DB_PASSWORD=local_weather_change_me

STORAGE_DB_NAME=warp_storage
STORAGE_DB_USER=warp_storage
STORAGE_DB_PASSWORD=local_storage_change_me

# Public key used by the frontend to display MapTiler map tiles.
# This value is bundled into the frontend and must not contain a secret key.
VITE_MAPTILER_API_KEY=your_public_maptiler_key

# Server-side key used only by the routing service for geocoding.
# Do not expose this value in frontend variables.
MAPTILER_GEOCODING_API_KEY=your_server_side_maptiler_key

# Shared secret for internal communication between BFF and services.
# Can be any value in a local environment; in production, it should be a long, random value.
WARP_INTERNAL_SERVICE_TOKEN=local_internal_service_token_change_me

# Server-side key used only by the routing service for routing.
OPENROUTESERVICE_API_KEY=your_server_side_openrouteservice_key

# Server-side Google Gemini API key used by the weather service for MCP-based AI weather analysis.
GEMINI_API_KEY=your_server_side_gemini_api_key


# Credentials of the local RabbitMQ broker (docker-compose.dev.yaml).
# Use URL-safe characters only: they are embedded in RABBITMQ_URL.
RABBITMQ_USER=warp
RABBITMQ_PASSWORD=local_rabbitmq_change_me