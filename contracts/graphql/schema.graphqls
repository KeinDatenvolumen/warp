"""
WaRP GraphQL-Schema.

Die fachliche Anwendung kommuniziert über diesen Vertrag mit dem BFF.
Interne Services werden ausschließlich durch den BFF angesprochen.
"""
schema {
    query: Query
    mutation: Mutation
}

type Query {
    """
    Liefert den zusammengefassten Zustand des BFF und aller internen Services.
    """
    systemHealth: SystemHealth!
    """
    Liefert die aktuell authentifizierte Sitzung.

    Fehlt die Sitzung oder ist sie abgelaufen beziehungsweise invalidiert,
    wird der Fehler SESSION_INVALID zurückgegeben.
    """
    currentSession: CurrentSession!

    """
    Liefert die Kontodaten des angemeldeten Benutzers.
    Fehlt die Sitzung, wird SESSION_INVALID zurückgegeben.
    """
    currentUser: User

    """
    Liefert alle zentral konfigurierten Aktivitätsprofile.
    Die Profilparameter sind für Endbenutzer nicht veränderbar.
    """
    activityProfiles: [ActivityProfile!]!

    """
    Liefert ein zentral konfiguriertes Aktivitätsprofil anhand seines Codes.
    """
    activityProfile(code: ActivityProfileCode!): ActivityProfile!

    """
    Sucht passende Orte und Adressen anhand eines Suchbegriffs.
    """
    searchPlaces(query: String!, limit: Int = 5): [Place!]!

    """
    Liefert die gespeicherten Routen des angemeldeten Benutzers.
    Favoriten stehen zuerst, danach folgen die neuesten Routen.
    Mit filter.favorite kann die Liste auf Favoriten oder
    Nicht-Favoriten eingeschränkt werden.
    Fehlt die Sitzung, wird SESSION_INVALID zurückgegeben.
    """
    savedRoutes(filter: SavedRouteFilter, page: PageInput): SavedRoutePage!

    """
    Liefert eine eigene gespeicherte Route.
    Fremde oder unbekannte Routen führen zu SAVED_ROUTE_NOT_FOUND.
    """
    savedRoute(id: ID!): SavedRoute

    """
    Liefert den aktuellen Zustand oder das Ergebnis einer
    zuvor gestarteten Routenberechnung.
    """
    routeCalculation(id: ID!): RouteCalculation
}

type Mutation {
    """
    Startet eine neue Routenberechnung.

    Das BFF authentifiziert die Sitzung, prüft den Benutzer,
    lädt das gewählte Aktivitätsprofil und übergibt anschließend
    einen Profil-Snapshot an den Routing-Service.
    """
    startRouteCalculation(
        input: RouteCalculationInput!
    ): RouteCalculationPayload!

    """
    Speichert eine berechnete Route samt Wetterbewertung als eigene Route.
    """
    saveRoute(input: SaveRouteInput!): SaveRoutePayload!

    """
    Ändert Namen und/oder Favoritenstatus einer eigenen gespeicherten Route.
    """
    updateSavedRoute(id: ID!, input: UpdateSavedRouteInput!): UpdateSavedRoutePayload!

    """
    Löscht eine eigene gespeicherte Route.
    """
    deleteSavedRoute(id: ID!): DeleteSavedRoutePayload!
}

"""
Zusammengefasster Zustand aller WaRP-Services.
"""
type SystemHealth {
    status: SystemHealthStatus!
    checkedAt: DateTime!
    healthyServices: Int!
    totalServices: Int!
    services: [ServiceHealth!]!
}

"""
Zustand eines einzelnen Services.
"""
type ServiceHealth {
    service: String!
    status: ServiceHealthStatus!
    reachable: Boolean!
    responseTimeMs: Int!
}

"""
Eine gültige, aktuell authentifizierte Sitzung.
Die interne Session-ID und der rohe Session-Token werden nicht ausgegeben.
"""
type CurrentSession {
    userId: ID!
    createdAt: DateTime!
    expiresAt: DateTime!
}

"""
Ein zentral konfiguriertes Aktivitätsprofil.

Die Parameter werden zentral im Backend verwaltet und können
von Endbenutzern nicht verändert werden.
"""
type ActivityProfile {
    """
    Stabiler fachlicher Code des Aktivitätsprofils.
    """
    code: ActivityProfileCode!

    """
    Anzeigename für das Frontend.
    """
    displayName: String!
}

"""
Verfügbare Aktivitätsprofile.
"""
enum ActivityProfileCode {
    BICYCLE
    MOTORCYCLE
    HIKING
}

"""
Ein durch die Geocodierung gefundener Ort oder eine gefundene Adresse.
"""
type Place {
    placeId: ID!
    displayName: String!
    latitude: Float!
    longitude: Float!
}

"""
Eingabe zum Starten einer Routenberechnung.
"""
input RouteCalculationInput {
    start: RoutePointInput!
    destination: RoutePointInput!
    departureTime: DateTime!
    activityProfile: ActivityProfileCode!
}

"""
Start- oder Zielpunkt einer Routenberechnung.
"""
input RoutePointInput {
    label: String!
    latitude: Float!
    longitude: Float!
}

"""
Ergebnis der Mutation zum Starten einer Routenberechnung.
"""
type RouteCalculationPayload {
    calculation: RouteCalculation
    errors: [RouteCalculationMutationError!]!
}

"""
Aktueller Zustand oder Ergebnis einer Routenberechnung.
"""
type RouteCalculation {
    id: ID!
    status: RouteCalculationStatus!

    start: RoutePoint!
    destination: RoutePoint!

    activityProfile: ActivityProfile!

    departureTime: DateTime!
    arrivalTime: DateTime

    distanceMeters: Float
    durationSeconds: Float

    geometry: RouteGeometry
    segments: [RouteSegment!]

    weatherEvaluationId: ID
    weatherScore: Int
    weatherScoreVersion: String
    thunderstormCapApplied: Boolean
    weatherSegments: [SavedRouteWeatherSegment!]
    weatherEvaluation: WeatherEvaluation

    createdAt: DateTime!

    error: RouteCalculationError
}

"""
Vollständige Wetterbewertung einer berechneten Route.
"""
type WeatherEvaluation {
    evaluationId: ID!
    routeCalculationId: ID!
    status: RouteCalculationStatus!
    departureTime: DateTime!
    overallScore: Int!
    scoreVersion: String!
    thunderstormCapApplied: Boolean!
    weatherDataGeneratedAt: DateTime!
    weatherDataExpiresAt: DateTime!
    createdAt: DateTime!
    segments: [SavedRouteWeatherSegment!]!
}

"""
Start- oder Zielpunkt einer gespeicherten Routenberechnung.
"""
type RoutePoint {
    label: String!
    latitude: Float!
    longitude: Float!
}

"""
GeoJSON-Geometrie einer berechneten Route.
Die Koordinaten verwenden die Reihenfolge
Längengrad vor Breitengrad.
"""
type RouteGeometry {
    type: String!
    coordinates: [[Float!]!]!
}

"""
Abschnitt einer berechneten Route mit Distanz und Dauer.
"""
type RouteSegment {
    distanceMeters: Float!
    durationSeconds: Float!
}

"""
Fachlicher Fehler einer fehlgeschlagenen Routenberechnung.
"""
type RouteCalculationError {
    code: String!
    message: String!
}

"""
Fehler beim Starten einer Routenberechnung.
"""
type RouteCalculationMutationError {
    field: String
    code: String!
    message: String!
}

"""
Status einer Routenberechnung.
"""
enum RouteCalculationStatus {
    PENDING
    PROCESSING
    COMPLETED
    FAILED
}

enum SystemHealthStatus {
    UP
    DEGRADED
}

enum ServiceHealthStatus {
    UP
    DOWN
    OUT_OF_SERVICE
    UNKNOWN
    UNAVAILABLE
}

"""
Zeitpunkt nach ISO 8601, beispielsweise 2026-10-08T19:01:35Z.
"""
scalar DateTime

"""
Ein gespeicherter Ort (Start oder Ziel).
"""
type RoutePlace {
    label: String!
    latitude: Float!
    longitude: Float!
}

type SegmentWeather {
    windSpeedKmh: Float
    windDirectionDegrees: Float
    precipitationProbabilityPercent: Float
    precipitationMm: Float
    thunderstormProbabilityPercent: Float
    temperatureCelsius: Float
    weatherCode: Int
}

type SavedRouteWeatherSegment {
    segmentIndex: Int!
    distanceFromStartMeters: Int
    expectedArrivalTime: DateTime!
    score: Int!
    color: String!
    weather: SegmentWeather
    geometry: RouteGeometry
}

"""
Kurzansicht einer gespeicherten Route für die Listenansicht.
"""
type SavedRouteSummary {
    id: ID!
    name: String!
    start: RoutePlace!
    destination: RoutePlace!
    activityProfile: ActivityProfile!
    weatherScore: Int!
    favorite: Boolean!
    createdAt: DateTime!
}

"""
Vollständige Detailansicht einer gespeicherten Route inklusive Wetterscores.
"""
type SavedRoute {
    id: ID!
    name: String!
    start: RoutePlace!
    destination: RoutePlace!
    activityProfile: ActivityProfile!
    departureTime: DateTime!
    arrivalTime: DateTime!
    distanceMeters: Int!
    durationSeconds: Int!
    geometry: RouteGeometry!
    weatherScore: Int!
    weatherScoreVersion: String!
    thunderstormCapApplied: Boolean!
    weatherSegments: [SavedRouteWeatherSegment!]!
    favorite: Boolean!
    createdAt: DateTime!
    updatedAt: DateTime!
}

type SavedRoutePage {
    items: [SavedRouteSummary!]!
    pageInfo: PageInfo!
}

type PageInfo {
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
}

input SavedRouteFilter {
    favorite: Boolean
}

input PageInput {
    page: Int = 0
    size: Int = 20
}

input UpdateSavedRouteInput {
    name: String
    favorite: Boolean
}

"""
Feldbezogener, erwartbarer Fehler einer Mutation.
"""
type UserError {
    field: String
    code: String!
    message: String!
}

type UpdateSavedRoutePayload {
    route: SavedRoute
    errors: [UserError!]!
}

input SaveRouteInput {
    name: String!
    routeCalculationId: ID!
    weatherEvaluationId: ID!
    favorite: Boolean = false
}

type SaveRoutePayload {
    route: SavedRoute
    errors: [UserError!]!
}

type DeleteSavedRoutePayload {
    deletedRouteId: ID
    errors: [UserError!]!
}

"""
Kontodaten des angemeldeten Benutzers. Der Name ist nicht änderbar.
"""
type User {
    id: ID!
    name: String!
    email: String!
    emailVerified: Boolean!
    createdAt: DateTime!
}