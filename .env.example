IDENTITY_DB_NAME=warp_identity
IDENTITY_DB_USER=warp_identity
IDENTITY_DB_PASSWORD=local_identity_change_me

ROUTING_DB_NAME=warp_routing
ROUTING_DB_USER=warp_routing
ROUTING_DB_PASSWORD=local_routing_change_me

WEATHER_DB_NAME=warp_weather
WEATHER_DB_USER=warp_weather
WEATHER_DB_PASSWORD=local_weather_change_me

STORAGE_DB_NAME=warp_storage
STORAGE_DB_USER=warp_storage
STORAGE_DB_PASSWORD=local_storage_change_me

# Public key used by the frontend to display MapTiler map tiles.
# This value is bundled into the frontend and must not contain a secret key.
VITE_MAPTILER_API_KEY=your_public_maptiler_key

# Server-side key used only by the routing service for geocoding.
# Do not expose this value in frontend variables.
MAPTILER_GEOCODING_API_KEY=your_server_side_maptiler_key