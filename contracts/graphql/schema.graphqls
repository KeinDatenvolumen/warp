"""
WaRP GraphQL-Schema.

Die fachliche Anwendung kommuniziert über diesen Vertrag mit dem BFF.
Interne Services werden ausschließlich durch den BFF angesprochen.
"""
schema {
    query: Query
    mutation: Mutation
}

type Query {
    """
    Liefert den zusammengefassten Zustand des BFF und aller internen Services.
    """
    systemHealth: SystemHealth!
    """
    Liefert die aktuell authentifizierte Sitzung.

    Fehlt die Sitzung oder ist sie abgelaufen beziehungsweise invalidiert,
    wird der Fehler SESSION_INVALID zurückgegeben.
    """
    currentSession: CurrentSession!
    """
    Liefert alle zentral konfigurierten Aktivitätsprofile.
    Die Profilparameter sind für Endbenutzer nicht veränderbar.
    """
    activityProfiles: [ActivityProfile!]!

    """
    Liefert ein zentral konfiguriertes Aktivitätsprofil anhand seines Codes.
    """
    activityProfile(code: ActivityProfileCode!): ActivityProfile!

    """
    Sucht passende Orte und Adressen anhand eines Suchbegriffs.
    """
    searchPlaces(query: String!, limit: Int = 5): [Place!]!

    """
    Liefert den aktuellen Zustand oder das Ergebnis einer
    zuvor gestarteten Routenberechnung.
    """
    routeCalculation(id: ID!): RouteCalculation
}

type Mutation {
    """
    Startet eine neue Routenberechnung.

    Das BFF authentifiziert die Sitzung, prüft den Benutzer,
    lädt das gewählte Aktivitätsprofil und übergibt anschließend
    einen Profil-Snapshot an den Routing-Service.
    """
    startRouteCalculation(
        input: RouteCalculationInput!
    ): RouteCalculationPayload!
}

"""
Zusammengefasster Zustand aller WaRP-Services.
"""
type SystemHealth {
    status: SystemHealthStatus!
    checkedAt: DateTime!
    healthyServices: Int!
    totalServices: Int!
    services: [ServiceHealth!]!
}

"""
Zustand eines einzelnen Services.
"""
type ServiceHealth {
    service: String!
    status: ServiceHealthStatus!
    reachable: Boolean!
    responseTimeMs: Int!
}

"""
Eine gültige, aktuell authentifizierte Sitzung.
Die interne Session-ID und der rohe Session-Token werden nicht ausgegeben.
"""
type CurrentSession {
    userId: ID!
    createdAt: DateTime!
    expiresAt: DateTime!
}

"""
Ein zentral konfiguriertes Aktivitätsprofil.

Die Parameter werden zentral im Backend verwaltet und können
von Endbenutzern nicht verändert werden.
"""
type ActivityProfile {
    """
    Stabiler fachlicher Code des Aktivitätsprofils.
    """
    code: ActivityProfileCode!

    """
    Anzeigename für das Frontend.
    """
    displayName: String!
}

"""
Verfügbare Aktivitätsprofile.
"""
enum ActivityProfileCode {
    BICYCLE
    MOTORCYCLE
    HIKING
}

"""
Ein durch die Geocodierung gefundener Ort oder eine gefundene Adresse.
"""
type Place {
    placeId: ID!
    displayName: String!
    latitude: Float!
    longitude: Float!
}

"""
Eingabe zum Starten einer Routenberechnung.
"""
input RouteCalculationInput {
    start: RoutePointInput!
    destination: RoutePointInput!
    departureTime: DateTime!
    activityProfile: ActivityProfileCode!
}

"""
Start- oder Zielpunkt einer Routenberechnung.
"""
input RoutePointInput {
    label: String!
    latitude: Float!
    longitude: Float!
}

"""
Ergebnis der Mutation zum Starten einer Routenberechnung.
"""
type RouteCalculationPayload {
    calculation: RouteCalculation
    errors: [RouteCalculationMutationError!]!
}

"""
Aktueller Zustand oder Ergebnis einer Routenberechnung.
"""
type RouteCalculation {
    id: ID!
    status: RouteCalculationStatus!

    start: RoutePoint!
    destination: RoutePoint!

    activityProfile: ActivityProfile!

    departureTime: DateTime!
    arrivalTime: DateTime

    distanceMeters: Float
    durationSeconds: Float

    geometry: RouteGeometry
    segments: [RouteSegment!]

    createdAt: DateTime!

    error: RouteCalculationError
}

"""
Start- oder Zielpunkt einer gespeicherten Routenberechnung.
"""
type RoutePoint {
    label: String!
    latitude: Float!
    longitude: Float!
}

"""
GeoJSON-Geometrie einer berechneten Route.
Die Koordinaten verwenden die Reihenfolge
Längengrad vor Breitengrad.
"""
type RouteGeometry {
    type: String!
    coordinates: [[Float!]!]!
}

"""
Abschnitt einer berechneten Route mit Distanz und Dauer.
"""
type RouteSegment {
    distanceMeters: Float!
    durationSeconds: Float!
}

"""
Fachlicher Fehler einer fehlgeschlagenen Routenberechnung.
"""
type RouteCalculationError {
    code: String!
    message: String!
}

"""
Fehler beim Starten einer Routenberechnung.
"""
type RouteCalculationMutationError {
    field: String
    code: String!
    message: String!
}

"""
Status einer Routenberechnung.
"""
enum RouteCalculationStatus {
    PENDING
    PROCESSING
    COMPLETED
    FAILED
}

enum SystemHealthStatus {
    UP
    DEGRADED
}

enum ServiceHealthStatus {
    UP
    DOWN
    OUT_OF_SERVICE
    UNKNOWN
    UNAVAILABLE
}

"""
Zeitpunkt nach ISO 8601, beispielsweise 2026-10-08T19:01:35Z.
"""
scalar DateTime