<!-- [KI-Log Nr. KI-20] KI-generiert (Google Antigravity (Gemini 3.8 Flash High)): Multi-Page Application mit Express & EJS (WARP-034) -->
<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="main-content">
  <div class="container container-sm">
    <div class="error-card">
      <div class="error-code"><%= statusCode %></div>
      <h1 class="error-title">
        <% if (statusCode === 404) { %>
          Seite nicht gefunden
        <% } else { %>
          Ein Fehler ist aufgetreten
        <% } %>
      </h1>
      <p class="error-message"><%= message %></p>
      <div class="error-actions">
        <a href="/" class="btn btn-primary">Zur Übersicht</a>
        <a href="<%= routePlannerUrl %>" class="btn btn-outline" target="_blank" rel="noopener noreferrer">
          Zum Routenplaner (SPA) ↗
        </a>
      </div>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
