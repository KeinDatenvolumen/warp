<!-- [KI-Log Nr. KI-20] KI-generiert (Google Antigravity (Gemini 3.8 Flash High)): Multi-Page Application mit Express & EJS (WARP-034) -->
<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="main-content">
  <div class="container">
    <%- include('partials/alerts') %>

    <!-- Hero Section -->
    <section class="hero-section">
      <div class="hero-badge">Projektinitiative WaRP • Smarte Outdoor-Mobilität</div>
      <h1 class="hero-title">Weather-Aware Route Planner</h1>
      <p class="hero-subtitle">
        Warum sollte das Wetter deine Pläne durchkreuzen? WaRP verbindet meteorologische Präzisionsdaten
        mit dynamischer Streckenberechnung für Radfahrer, Motorradfahrer und Wanderer –
        für maximale Sicherheit, weniger Regenschauer und das optimale Abfahrtszeitfenster.
      </p>

      <% if (locals.isAuthenticated && user) { %>
        <div class="user-greeting-card">
          <div class="greeting-avatar">👤</div>
          <div class="greeting-content">
            <h2>Willkommen zurück, <%= user.name %>!</h2>
            <p>Angemeldet mit <code><%= user.email %></code> • Entdecke die Projektvision oder starte direkt eine Tour.</p>
          </div>
          <div class="greeting-actions">
            <a href="/profile" class="btn btn-primary">Mein Profil & Touchpoint</a>
            <a href="<%= routePlannerUrl %>" class="btn btn-secondary" target="_blank" rel="noopener noreferrer">
              Zum Routenplaner ↗
            </a>
          </div>
        </div>
      <% } else { %>
        <div class="hero-cta-group">
          <a href="<%= routePlannerUrl %>" class="btn btn-accent btn-lg" target="_blank" rel="noopener noreferrer">
            Routenplaner direkt testen ↗
          </a>
          <a href="/register" class="btn btn-primary btn-lg">Konto erstellen</a>
          <a href="/login" class="btn btn-outline btn-lg">Anmelden</a>
        </div>
      <% } %>
    </section>

    <!-- Unsere Motivation -->
    <section class="section-container" id="motivation">
      <div class="section-header">
        <span class="section-eyebrow">Unsere Motivation</span>
        <h2>Warum herkömmliche Navis bei Wetterumschwüngen versagen</h2>
        <p class="section-desc">
          Jeder Outdoor-Begeisterte kennt das Dilemma: Die Tour startet bei blauem Himmel, doch zwei Stunden
          später überrascht eine Regenfront oder tückische Sturmböen machen die Weiterfahrt unsicher.
        </p>
      </div>

      <div class="info-grid">
        <div class="info-card">
          <div class="info-icon">🌧️</div>
          <h3>Starre Routenführung</h3>
          <p>
            Klassische Routenplaner kennen nur Start, Ziel und Straßennetze. Wie sich das Wetter entlang deiner Tour über die nächsten Stunden verändert, bleibt völlig unberücksichtigt.
          </p>
        </div>
        <div class="info-card">
          <div class="info-icon">📱</div>
          <h3>App-Chaos unterwegs</h3>
          <p>
            Wer auf Nummer sicher gehen will, jongliert mühsam zwischen Navigations-Apps, Regenradaren und Windprognosen. Die Abfahrtszeit bleibt dabei oft ein riskantes Glücksspiel.
          </p>
        </div>
        <div class="info-card">
          <div class="info-icon">💡</div>
          <h3>Wetter als aktiver Faktor</h3>
          <p>
            WaRP schließt diese Lücke: Wir berechnen die Wetterbedingungen genau für den Moment, in dem du einen Streckenabschnitt passierst – für planbare und entspannte Touren.
          </p>
        </div>
      </div>
    </section>

    <!-- Unsere Vision -->
    <section class="section-container">
      <div class="section-header">
        <span class="section-eyebrow">Unsere Vision</span>
        <h2>Vorausschauende Mobilität für alle Outdoor-Begeisterten</h2>
        <p class="section-desc">
          Wir wollen Outdoor-Mobilität sicherer, verlässlicher und unbeschwerter machen – ganz gleich, wie das Wetter spielt.
        </p>
      </div>

      <div class="info-grid">
        <div class="info-card">
          <div class="info-icon">🛡️</div>
          <h3>Sicherheit voranbringen</h3>
          <p>
            Kritische Wetterphänomene wie Aquaplaning-Risiko, Sturmböen oder plötzliche Kälteeinbrüche frühzeitig erkennen und durch smarte Alternativrouten umgehen.
          </p>
        </div>
        <div class="info-card">
          <div class="info-icon">⏱️</div>
          <h3>Das perfekte Zeitfenster</h3>
          <p>
            Oft entscheidet eine halbe Stunde über Sonnenschein oder Dauerregen. Unser intelligenter Zeitschieber ermittelt den besten Startzeitpunkt im Handumdrehen.
          </p>
        </div>
        <div class="info-card">
          <div class="info-icon">🤝</div>
          <h3>Offen & Individualisiert</h3>
          <p>
            Ob sportliches Rennrad, kurvige Motorradstrecke oder alpine Wanderroute: WaRP passt sich den individuellen Anforderungen deines Fortbewegungsmittels an.
          </p>
        </div>
      </div>
    </section>

    <!-- Was kann unser Produkt? (Produktfunktionen) -->
    <section class="section-container">
      <div class="section-header">
        <span class="section-eyebrow">Produktfunktionen</span>
        <h2>Was kann unser Produkt?</h2>
        <p class="section-desc">
          Modernste Wettermodelle, intelligente Algorithmen und praktische Werkzeuge für deine Streckenplanung:
        </p>
      </div>

      <div class="info-grid">
        <div class="info-card">
          <div class="info-icon">🎯</div>
          <h3>101-Punkte Wetter-Score</h3>
          <p>
            Ein transparenter Score von 0 bis 100 fasst Temperatur, Niederschlag, Wind und Sichtbedingungen entlang deiner Route verständlich zusammen.
          </p>
        </div>
        <div class="info-card">
          <div class="info-icon">⏰</div>
          <h3>Intelligenter Abfahrtszeit-Schieber</h3>
          <p>
            Erkunde Startzeiten im 15-Minuten-Raster für bis zu ±2 Stunden. So siehst du sofort, ob eine frühere oder spätere Abfahrt das Wetter spürbar verbessert.
          </p>
        </div>
        <div class="info-card">
          <div class="info-icon">🤖</div>
          <h3>KI-gestützter Wetterberater</h3>
          <p>
            Unser digitaler Assistent bewertet die meteorologische Lage verständlich in Klartext und gibt dir wertvolle Empfehlungen zu Kleidung und Ausrüstung.
          </p>
        </div>
        <div class="info-card">
          <div class="info-icon">💾</div>
          <h3>Routen speichern & GPX-Export</h3>
          <p>
            Plane im Voraus, sichere deine Lieblingsrouten in deinem Konto und exportiere sie als standardisierte GPX-Datei für dein Fahrrad-Navi, Smartwatch oder Motorrad.
          </p>
        </div>
      </div>
    </section>

    <!-- Interaktiver Routenplaner Teaser Card -->
    <section class="planner-feature-card">
      <div class="planner-card-badge">Live erleben</div>
      <div class="planner-card-grid">
        <div class="planner-card-text">
          <h2>Der interaktive Routenplaner</h2>
          <p>
            Erlebe die Zukunft des Routenplanens direkt im Browser: Interaktive Karte, Höhenprofil,
            dynamischer Zeitschieber und KI-Wetteranalyse in Echtzeit.
          </p>
          <ul class="feature-bullets">
            <li>🗺️ Interaktive Kartenansicht mit Wegpunkten und weltweitem Geocoding</li>
            <li>⛅ Streckenbezogene Wetterprognosen im 15-Minuten-Intervall</li>
            <li>📊 Höhenprofil und detaillierte Wetterabschnitte auf einen Blick</li>
            <li>🤖 Kontextbezogene KI-Reiseberatung für jede geplante Tour</li>
          </ul>
          <a href="<%= routePlannerUrl %>" class="btn btn-accent btn-lg" target="_blank" rel="noopener noreferrer">
            Routenplaner jetzt starten ↗
          </a>
        </div>
        <div class="planner-card-visual">
          <div class="visual-mockup">
            <div class="mockup-header">
              <span class="dot dot-red"></span>
              <span class="dot dot-yellow"></span>
              <span class="dot dot-green"></span>
              <span class="mockup-title">WaRP Live Route Planner</span>
            </div>
            <div class="mockup-body">
              <div class="mockup-row">
                <span class="badge badge-success">Wetter-Score: 88 / 100</span>
                <span class="badge badge-info">Fahrrad-Profil</span>
              </div>
              <p class="mockup-text">Optimale Startzeit: 14:15 Uhr • Trockene Abschnitte auf 94 % der Strecke</p>
              <div class="mockup-progress"></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Aktivitätsprofile Section -->
    <section class="section-container">
      <div class="section-header">
        <span class="section-eyebrow">Für wen ist WaRP gedacht?</span>
        <h2>Maßgeschneiderte Aktivitätsprofile</h2>
        <p class="section-desc">
          Jedes Fortbewegungsmittel hat spezifische Wetteranforderungen. WaRP berücksichtigt diese Unterschiede direkt im Bewertungsmodell:
        </p>
      </div>

      <div class="profiles-grid">
        <% activityProfiles.forEach(function(profile) { %>
          <div class="profile-card">
            <div class="profile-card-icon">
              <% if (profile.code === 'BICYCLE') { %>
                🚲
              <% } else if (profile.code === 'MOTORCYCLE') { %>
                🏍️
              <% } else if (profile.code === 'HIKING') { %>
                🥾
              <% } else { %>
                🧭
              <% } %>
            </div>
            <h3 class="profile-card-title"><%= profile.displayName %></h3>
            <p class="profile-card-text">
              <% if (profile.code === 'BICYCLE') { %>
                Für Rennrad, Gravel und Alltagsradler: Windrichtung, Gegenwind-Prognose und Niederschlag fließen stark in die Routenbewertung ein.
              <% } else if (profile.code === 'MOTORCYCLE') { %>
                Für Motorrad- und Kurvenliebhaber: Priorisiert Grip, Sichtweiten und meidet gefährliche Fahrbahnnässe sowie Sturmböen.
              <% } else if (profile.code === 'HIKING') { %>
                Für Wanderer und Outdoorsportler: Fokus auf Temperaturstürze, Gewitterrisiko und Schutz vor ungemütlichen Wetterwechseln im Gelände.
              <% } else { %>
                Optimiertes Profil für maßgeschneiderte Tourenplanung im WaRP-System.
              <% } %>
            </p>
          </div>
        <% }); %>
      </div>
    </section>

    <!-- Über das Projekt -->
    <section class="section-container">
      <div class="section-header">
        <span class="section-eyebrow">Über das Projekt</span>
        <h2>Entstehung an der DHBW Mosbach</h2>
        <p class="section-desc">
          WaRP wurde als innovatives Mobilitätsprojekt im Rahmen des Moduls Fortgeschrittene Systementwicklung an der DHBW Mosbach ins Leben gerufen. Unser Anspruch: Komplexe meteorologische Datenmodelle verständlich und nützlich für jeden Outdoor-Sportler nutzbar zu machen.
        </p>
      </div>
    </section>
  </div>
</main>

<%- include('partials/footer') %>
