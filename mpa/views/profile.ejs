<!-- [KI-Log Nr. KI-20] KI-generiert (Google Antigravity (Gemini 3.8 Flash High)): Multi-Page Application mit Express & EJS (WARP-034) -->
<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="main-content">
  <div class="container container-md">
    <div class="profile-header-card">
      <div class="profile-avatar-large">👤</div>
      <div class="profile-header-text">
        <span class="profile-badge">Interessenten- & Community-Touchpoint</span>
        <h1 class="profile-name">Willkommen, <%= user.name %>!</h1>
        <p class="profile-email"><%= user.email %></p>
      </div>
    </div>

    <%- include('partials/alerts') %>

    <div class="profile-grid">
      <!-- Dein Profil & Mitgliedschaft -->
      <section class="card profile-info-card">
        <div class="card-header">
          <h2>Dein Mitgliedsstatus</h2>
          <% if (user.emailVerified) { %>
            <span class="badge badge-success">✓ Bestätigt</span>
          <% } else { %>
            <span class="badge badge-warning">⏳ E-Mail unbestätigt</span>
          <% } %>
        </div>
        <div class="card-body">
          <dl class="data-list">
            <div class="data-item">
              <dt>Name</dt>
              <dd><strong><%= user.name %></strong></dd>
            </div>
            <div class="data-item">
              <dt>E-Mail-Adresse</dt>
              <dd><%= user.email %></dd>
            </div>
            <div class="data-item">
              <dt>Mitglied seit</dt>
              <dd><%= formattedCreatedAt %></dd>
            </div>
            <div class="data-item">
              <dt>Sitzungsdauer</dt>
              <dd>Sicher angemeldet bis <%= formattedExpiresAt %></dd>
            </div>
          </dl>
          <div class="profile-card-footer text-muted">
            <small>Konto-ID: <%= user.id %> • Anbindung über WaRP GraphQL Gateway</small>
          </div>
        </div>
      </section>

      <!-- Aktueller Projekt-Status -->
      <section class="card profile-session-card">
        <div class="card-header">
          <h2>Projekt-Status & Roadmap</h2>
          <span class="badge badge-info">Version 1.0 Live</span>
        </div>
        <div class="card-body">
          <p style="font-size: 0.95rem; color: var(--color-text-muted); margin-bottom: 1rem;">
            Hier erfährst du, woran das WaRP-Team aktuell arbeitet und welche Neuerungen für dich als Interessent und Nutzer anstehen:
          </p>
          <ul class="roadmap-list">
            <li class="roadmap-item">
              <span>✅</span>
              <div>
                <strong>DWD & Open-Meteo Integration:</strong>
                Präzise Wetterdaten entlang des gesamten Routenverlaufs.
              </div>
            </li>
            <li class="roadmap-item">
              <span>✅</span>
              <div>
                <strong>KI-Wetterberater:</strong>
                Empfehlungen für Bekleidung und Ausrüstung in natürlicher Sprache.
              </div>
            </li>
            <li class="roadmap-item">
              <span>🚀</span>
              <div>
                <strong>In Planung:</strong>
                Schutzhütten-POIs, Offline-Karten und mobile App-Unterstützung.
              </div>
            </li>
          </ul>
        </div>
      </section>
    </div>

    <!-- Vollbreiter Touchpoint für Interessenten & Partner -->
    <section class="touchpoint-card card">
      <div class="card-header">
        <h2>Möglichkeiten für Interessenten, Partner & Tester</h2>
        <span class="badge badge-graphql">Community & Co-Creation</span>
      </div>
      <div class="card-body">
        <p style="font-size: 1rem; color: var(--color-text); margin-bottom: 1.5rem; line-height: 1.5;">
          WaRP versteht sich als offene Plattform für innovative Mobilitätslösungen. Als registrierter Interessent hast du exklusive Möglichkeiten, die Zukunft wetterbewusster Routenplanung aktiv mitzugestalten:
        </p>

        <div class="touchpoint-columns">
          <div class="touchpoint-col">
            <h3><span>🧪</span> Early Access</h3>
            <p>
              Probiere neue Routen- und Wetterbewertungsalgorithmen noch vor dem offiziellen Release auf deinen Lieblingstouren aus.
            </p>
          </div>
          <div class="touchpoint-col">
            <h3><span>💬</span> Feedback & Ideen</h3>
            <p>
              Fehlen dir bestimmte Wetterkriterien wie UV-Index oder Windschatten? Teile deine Ideen direkt mit unserem Entwicklungsteam.
            </p>
          </div>
          <div class="touchpoint-col">
            <h3><span>🤝</span> Kooperationen</h3>
            <p>
              Interessant für Tourismusregionen, Sportvereine und Navigationsplattformen: Wir bieten Schnittstellen und Know-how für Kooperationen.
            </p>
          </div>
        </div>

        <div class="contact-highlight-box">
          <strong>Direkter Draht zum Entwicklungsteam:</strong> Du möchtest dich mit uns austauschen, hast Anregungen oder Interesse an einer Zusammenarbeit? Erreiche uns jederzeit unter <code>team@warp-routing.local</code> oder informiere dich in unserem Projekt-Repository.
        </div>
      </div>
    </section>

    <!-- Quick Links & Actions -->
    <div class="profile-actions-card">
      <h2>Aktionen</h2>
      <div class="profile-actions-grid">
        <a href="<%= routePlannerUrl %>" class="btn btn-primary btn-lg" target="_blank" rel="noopener noreferrer">
          🗺️ Zum Routenplaner (SPA) öffnen ↗
        </a>
        <a href="/" class="btn btn-outline btn-lg">
          🏠 Zurück zur Projektübersicht
        </a>
        <form action="/logout" method="POST" class="inline-form">
          <button type="submit" class="btn btn-danger btn-lg">
            🚪 Jetzt Abmelden
          </button>
        </form>
      </div>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
