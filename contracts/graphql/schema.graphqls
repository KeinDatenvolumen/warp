"""
WaRP GraphQL-Schema.

Die fachliche Anwendung kommuniziert über diesen Vertrag mit dem BFF.
Interne Services werden ausschließlich durch den BFF angesprochen.
"""
schema {
    query: Query
    mutation: Mutation
}

type Query {
    """
    Liefert den zusammengefassten Zustand des BFF und aller internen Services.
    """
    systemHealth: SystemHealth!

    """
    Liefert alle zentral konfigurierten Aktivitätsprofile.
    Die Profilparameter sind für Endbenutzer nicht veränderbar.
    """
    activityProfiles: [ActivityProfile!]!
}

type Mutation {
    """
    Technischer Platzhalter, bis die erste fachliche Mutation implementiert wird.
    """
    _empty: Boolean
}

"""
Zusammengefasster Zustand aller WaRP-Services.
"""
type SystemHealth {
    status: SystemHealthStatus!
    checkedAt: DateTime!
    healthyServices: Int!
    totalServices: Int!
    services: [ServiceHealth!]!
}

"""
Zustand eines einzelnen Services.
"""
type ServiceHealth {
    service: String!
    status: ServiceHealthStatus!
    reachable: Boolean!
    responseTimeMs: Int!
}

"""
Ein zentral konfiguriertes Aktivitätsprofil.

Die Parameter werden zentral im Backend verwaltet und können
von Endbenutzern nicht verändert werden.
"""
type ActivityProfile {
    """
    Stabiler fachlicher Code des Aktivitätsprofils.
    """
    code: ActivityProfileCode!

    """
    Anzeigename für das Frontend.
    """
    displayName: String!

    """
    Zentrale Durchschnittsgeschwindigkeit in km/h.
    """
    averageSpeedKmh: Float!

    """
    Dem Aktivitätsprofil zugeordnetes Routingprofil.
    """
    routingProfile: RoutingProfileCode!

    """
    Zentrales Wetter-Abfrageintervall in Minuten.
    """
    weatherQueryIntervalMinutes: Int!

    """
    Zentrale Wegepräferenzen des Profils.
    """
    wayPreferences: WayPreferences!
}

"""
Verfügbare Aktivitätsprofile.
"""
enum ActivityProfileCode {
    BICYCLE
    MOTORCYCLE
    HIKING
}

"""
Routingprofil eines Aktivitätsprofils.
"""
enum RoutingProfileCode {
    BICYCLE
    MOTORCYCLE
    FOOT
}

"""
Zentrale Wegepräferenzen eines Aktivitätsprofils.

Diese Werte können von Endbenutzern nicht verändert werden.
"""
type WayPreferences {
    """
    Bevorzugt ausgewiesene Fahrradwege.
    """
    preferCycleways: Boolean!

    """
    Vermeidet Autobahnen.
    """
    avoidMotorways: Boolean!

    """
    Vermeidet mautpflichtige Straßen.
    """
    avoidTollRoads: Boolean!

    """
    Vermeidet unbefestigte Wege.
    """
    avoidUnpavedWays: Boolean!

    """
    Bevorzugt befestigte Wege.
    """
    preferPavedWays: Boolean!

    """
    Bevorzugt landschaftlich attraktive Wege.
    """
    preferScenicWays: Boolean!
}

enum SystemHealthStatus {
    UP
    DEGRADED
}

enum ServiceHealthStatus {
    UP
    DOWN
    OUT_OF_SERVICE
    UNKNOWN
    UNAVAILABLE
}

"""
Zeitpunkt nach ISO 8601, beispielsweise 2026-10-08T19:01:35Z.
"""
scalar DateTime