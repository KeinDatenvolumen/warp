<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="main-content">
  <div class="container container-md">
    <div class="profile-header-card">
      <div class="profile-avatar-large">👤</div>
      <div class="profile-header-text">
        <span class="profile-badge">Persönlicher Mitgliederbereich</span>
        <h1 class="profile-name">Willkommen, <%= user.name %>!</h1>
        <p class="profile-email"><%= user.email %></p>
      </div>
    </div>

    <%- include('partials/alerts') %>

    <div class="profile-grid">
      <!-- Dein Profil & Mitgliedschaft -->
      <section class="card profile-info-card">
        <div class="card-header">
          <h2>Dein Mitgliedsstatus</h2>
          <% if (user.emailVerified) { %>
            <span class="badge badge-success">✓ Bestätigt</span>
          <% } else { %>
            <span class="badge badge-warning">⏳ E-Mail unbestätigt</span>
          <% } %>
        </div>
        <div class="card-body">
          <dl class="data-list">
            <div class="data-item">
              <dt>Name</dt>
              <dd><strong><%= user.name %></strong></dd>
            </div>
            <div class="data-item">
              <dt>E-Mail-Adresse</dt>
              <dd><%= user.email %></dd>
            </div>
            <div class="data-item">
              <dt>Mitglied seit</dt>
              <dd><%= formattedCreatedAt %></dd>
            </div>
            <div class="data-item">
              <dt>Sitzungsdauer</dt>
              <dd>Sicher angemeldet bis <%= formattedExpiresAt %></dd>
            </div>
          </dl>
        </div>
      </section>

      <!-- Aktueller Projekt-Status -->
      <section class="card profile-session-card">
        <div class="card-header">
          <h2>Projekt-Status & Ausblick</h2>
          <span class="badge badge-info">Aktuell</span>
        </div>
        <div class="card-body">
          <p style="font-size: 0.95rem; color: var(--color-text-muted); margin-bottom: 1rem;">
            Hier erfährst du, woran das WaRP-Team aktuell arbeitet und welche Neuerungen für dich als Nutzer bereitstehen:
          </p>
          <ul class="roadmap-list">
            <li class="roadmap-item">
              <span>✅</span>
              <div>
                <strong>Präzise Strecken-Wetterprognose:</strong>
                Zeit- und ortsgenaue Wetterdaten entlang des gesamten Routenverlaufs.
              </div>
            </li>
            <li class="roadmap-item">
              <span>✅</span>
              <div>
                <strong>KI-Wetterberater:</strong>
                Empfehlungen für Bekleidung, Ausrüstung und kritische Streckenabschnitte in verständlicher Sprache.
              </div>
            </li>
            <li class="roadmap-item">
              <span>🚀</span>
              <div>
                <strong>Ausblick:</strong>
                Schutzhütten entlang der Strecke, erweiterte Pausenplanung und mobile Unterstützung.
              </div>
            </li>
          </ul>
        </div>
      </section>
    </div>

    <!-- Vollbreiter Bereich für Interessenten & Partner -->
    <section class="touchpoint-card card">
      <div class="card-header">
        <h2>Möglichkeiten für Interessenten, Partner & Tester</h2>
        <span class="badge badge-graphql">Community</span>
      </div>
      <div class="card-body">
        <p style="font-size: 1rem; color: var(--color-text); margin-bottom: 1.5rem; line-height: 1.5;">
          WaRP versteht sich als offene Plattform für wetterbewusste Tourenplanung. Als registriertes Mitglied kannst du die Weiterentwicklung aktiv begleiten:
        </p>

        <div class="touchpoint-columns">
          <div class="touchpoint-col">
            <h3><span>🧪</span> Neue Funktionen testen</h3>
            <p>
              Probiere neue Funktionen zur Wetter- und Abfahrtszeitbewertung frühzeitig auf deinen eigenen Lieblingstouren aus.
            </p>
          </div>
          <div class="touchpoint-col">
            <h3><span>💬</span> Feedback & Ideen</h3>
            <p>
              Fehlen dir bestimmte Wetterkriterien oder Hinweise für deine Sportart? Teile deine Erfahrungen direkt mit unserem Team.
            </p>
          </div>
          <div class="touchpoint-col">
            <h3><span>🤝</span> Kooperationen</h3>
            <p>
              Interessant für Tourismusregionen, Radsport- und Wandervereine: Gemeinsam machen wir Outdoor-Touren sicherer und besser planbar.
            </p>
          </div>
        </div>

        <div class="contact-highlight-box">
          <strong>Direkter Kontakt zum Team:</strong> Du möchtest dich mit uns austauschen, hast Anregungen oder Interesse an einer Zusammenarbeit? Erreiche uns jederzeit unter <code>team@warp-routing.local</code>.
        </div>
      </div>
    </section>

    <!-- Quick Links & Actions -->
    <div class="profile-actions-card">
      <h2>Aktionen</h2>
      <div class="profile-actions-grid">
        <a href="<%= routePlannerUrl %>" class="btn btn-primary btn-lg" target="_blank" rel="noopener noreferrer">
          🗺️ Zum Routenplaner öffnen ↗
        </a>
        <a href="/" class="btn btn-outline btn-lg">
          🏠 Zurück zur Projektübersicht
        </a>
        <form action="/logout" method="POST" class="inline-form">
          <button type="submit" class="btn btn-danger btn-lg">
            🚪 Jetzt Abmelden
          </button>
        </form>
      </div>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
